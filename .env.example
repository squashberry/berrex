# BerreX provider configuration
# IMPORTANT: VITE_* values are bundled into the browser build.
# Do not put a privileged/private production API key here.
# For a public GitHub Pages build, use a restricted key or move provider
# requests behind a Cloudflare Worker/server before enabling production data.

VITE_FMP_API_KEY=
VITE_TWELVEDATA_API_KEY=
VITE_MARKET_API_URL=
VITE_MARKET_WS_URL=

# Optional server endpoint for AI analysis
VITE_AI_ENDPOINT=

# Optional broker referral
VITE_EXNESS_REFERRAL_URL=https://www.exness.com/

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SOCIAL_API_URL=
